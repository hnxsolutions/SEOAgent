# ============================================
# SEO Agent SaaS - Environment Variables
# ============================================
# Copy this file to .env and update the values

# ============================================
# Application Settings
# ============================================
APP_NAME="SEO Agent SaaS"
APP_ENV=development
APP_DEBUG=True
APP_URL=http://localhost

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_USER=seoagent
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=seoagent
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://seoagent:change-me-postgres-password@localhost:5432/seoagent

# ============================================
# Redis
# ============================================
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_REQUIRED=false

# ============================================
# Qdrant Vector Database
# ============================================
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_HOST=localhost
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Optional embedded local Qdrant storage path for development without Docker
QDRANT_LOCAL_PATH=
QDRANT_REQUIRED=false

# Local semantic indexing (self-hosted; no paid AI API keys required)
SEMANTIC_EMBEDDING_PROVIDER=sentence-transformers
SEMANTIC_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SEMANTIC_EMBEDDING_DIMENSION=384
SEMANTIC_QDRANT_COLLECTION=seo_semantic_chunks
KNOWLEDGE_QDRANT_COLLECTION=seo_knowledge_chunks
SEMANTIC_CHUNK_MAX_WORDS=220
SEMANTIC_CHUNK_OVERLAP_WORDS=40
SEMANTIC_EMBED_BATCH_SIZE=32

# ============================================
# Backend API
# ============================================
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# ============================================
# Frontend
# ============================================
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ============================================
# Authentication & Security
# ============================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# This key signs app tokens and derives the local Fernet key used to encrypt
# stored provider refresh tokens, including Google Search Console OAuth tokens.
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth Providers (Optional)
# Google Search Console OAuth uses the backend redirect URI below. Add the same
# URI to the Authorized redirect URIs for your Google OAuth web client.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/search-console/connections/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/search-console/connections/google/callback
GSC_TOKEN_ENCRYPTION_KEY=change-me-generate-dedicated-token-encryption-seed

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/github

# ============================================
# Local AI/LLM Configuration
# ============================================
# Self-hosted Ollama connector; no paid API key required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_RETRIES=2

# ============================================
# LangGraph Configuration
# ============================================
LANGGRAPH_CHECKPOINT_TTL=3600

# ============================================
# Stripe Billing (Optional)
# ============================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=
STRIPE_PRICE_ID_ENTERPRISE=

# ============================================
# Email Configuration (Optional)
# ============================================
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM=noreply@seoagent.com
EMAIL_FROM_NAME=SEO Agent

# ============================================
# Storage (S3-compatible)
# ============================================
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=seo-agent-uploads
STORAGE_ENDPOINT=

# ============================================
# SEO Tools & APIs
# ============================================
# Google Search Console API uses free OAuth, not paid SEO APIs.
GSC_SYNC_ROW_LIMIT=25000
GSC_HIGH_IMPRESSIONS_THRESHOLD=100
GSC_POSITION_DROP_THRESHOLD=2.0
GSC_CTR_DROP_THRESHOLD=0.25
GSC_CLICK_DECLINE_THRESHOLD=0.2
GSC_URL_INSPECTION_MAX_URLS_PER_RUN=50
GSC_URL_INSPECTION_REQUEST_DELAY_SECONDS=1.0
GSC_URL_INSPECTION_LANGUAGE_CODE=en-US
# Sitemap intelligence (detection/analysis work without Google credentials;
# submit/delete/list use the official GSC Sitemaps API and need the write scope).
GSC_SITEMAP_FETCH_TIMEOUT_SECONDS=20.0
GSC_SITEMAP_MAX_URLS_PARSED=5000
GSC_SITEMAP_MAX_BYTES=15000000
GSC_SITEMAP_USER_AGENT="SEOAgentBot/1.0 (+sitemap-intelligence)"

# ============================================
# Scheduler Runner
# ============================================
# Required only when calling POST /api/v1/scheduler/tick from a trusted cron.
SCHEDULER_INTERNAL_API_KEY=change-me-internal-scheduler-key
# Optional Docker scheduler service cadence.
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_TICK_LIMIT=50

# ============================================
# SEO Code Agent / GitHub PRs (Optional)
# ============================================
# Optional GitHub token for creating draft PRs from approved local patches.
# Not required for local scan, patch generation, tests, or patch application.
GITHUB_TOKEN=
GITHUB_DEFAULT_BASE_BRANCH=main
# Comma-, semicolon-, or newline-separated validation commands, disabled by default.
# Example: npm run lint,npm run typecheck,npm run build
REPO_AGENT_VALIDATION_COMMANDS=
REPO_AGENT_GIT_COMMAND_TIMEOUT_SECONDS=120

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Nginx (Production)
# ============================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ============================================
# Feature Flags
# ============================================
FEATURE_CRAWLER_ENABLED=True
FEATURE_SERP_ANALYSIS_ENABLED=True
FEATURE_AI_VISIBILITY_ENABLED=True
FEATURE_COMPETITOR_ANALYSIS_ENABLED=True
